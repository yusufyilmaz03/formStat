# FormStat backend ortam değişkenleri (opsiyonel — hepsinin makul varsayılanı var)

# Veritabanı (varsayılan: ../data/formstat.db)
# DATABASE_URL=sqlite:///./data/formstat.db

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth (Faz 6 — kişisel Google Cloud "Desktop" istemcisi)
# Google Cloud Console'dan indirdiğin client_secret.json dosyasını data/ içine koy
# GOOGLE_CLIENT_SECRET_FILE=./data/client_secret.json
# OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
